# Never commit real credentials. Existing .env is not modified by this change.
APP_ENV=development
WEBAPP_URL=http://127.0.0.1:8000
BOT_TOKEN=
DATABASE_URL=
DATABASE_PUBLIC_URL=

# Required to accept Telegram payment webhooks; without it this endpoint returns 503.
# Register the same secret in Telegram setWebhook.
TELEGRAM_PAYMENT_WEBHOOK_SECRET=
TELEGRAM_AUTH_MAX_AGE_SECONDS=3600
ENABLE_DEV_PAYMENTS=0
PROSTUDIO_MOCK_GENERATION=0

# Comma-separated real origins of the SYLVEX website (e.g. https://sylvex.ai),
# if it is deployed on a different domain than this backend. Enables CORS +
# credentialed cross-origin requests for that origin only. Leave empty to
# keep the website unreachable cross-origin (safe default, no behavior change).
WEBSITE_ORIGINS=
# Signs the SYLVEX website's browser session cookie (separate from BOT_TOKEN
# so a leak of one never compromises the other). Falls back to a
# domain-separated BOT_TOKEN key if unset, which works but is not
# recommended for production. Keep stable between deploys; rotating it signs
# out every website session.
WEB_SESSION_SECRET=
WEB_SESSION_MAX_AGE_SECONDS=2592000

# Used to build links inside verification/password-reset emails
# (e.g. https://sylvex.ai) - should match the deployed website's real origin.
WEBSITE_URL=
# Transactional email for website email/password accounts (verification,
# password reset, Telegram<->website merge codes), sent over the Resend
# HTTPS API (POST https://api.resend.com/emails) rather than SMTP - Railway's
# outbound SMTP is blocked/unreliable depending on plan. Leave
# RESEND_API_KEY empty to no-op (logs instead of sending) - registration/
# login/merge never fail just because mail isn't configured yet.
RESEND_API_KEY=
# Must be on a domain verified in Resend (e.g. sylvex.ai).
EMAIL_FROM=SYLVEX <noreply@sylvex.ai>

# Google Sign-In ("Continue with Google"): the OAuth Client ID from Google
# Cloud Console (a public value, safe to set - no client secret is needed,
# server-side verification only checks the ID token's signature/audience).
# Leave empty to keep the Google button hidden on both the website and the
# Mini App until this is configured.
GOOGLE_OAUTH_CLIENT_ID=
# Sign in with Apple: requires a paid Apple Developer Program enrollment, a
# configured Services ID (used here as the client id) and its registered
# redirect URI. The verification code is complete and functional; only this
# configuration is outstanding. Leave empty to keep the Apple button hidden.
APPLE_OAUTH_CLIENT_ID=

# Optional independent signing key. Falls back to a domain-separated BOT_TOKEN key.
# Keep stable between deploys; rotating it expires media and PayPal owner bindings.
MEDIA_SIGNING_SECRET=
MEDIA_URL_TTL_SECONDS=604800
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Leave empty for private media. Disable the bucket's public r2.dev/custom-domain access in Cloudflare.
R2_PUBLIC_BASE_URL=
# Former public origin, if any, used ONLY to map old history URLs into the private proxy.
LEGACY_R2_PUBLIC_BASE_URL=

# Same quota bucket across helper endpoints and application replicas.
PROVIDER_REQUESTS_PER_MINUTE=12
PROVIDER_REQUESTS_PER_DAY=200
UPLOAD_REQUESTS_PER_MINUTE=12
UPLOAD_REQUESTS_PER_DAY=200
API_IP_REQUESTS_PER_MINUTE=1200
# Runs the generation/reminder loops inside THIS process. Keep both at 1 for a
# single-service deployment. If worker.py is deployed as its own Railway
# service (see railway.worker.json), set both to 0 on the WEB service's
# environment variables so the two processes don't drain the same queue and
# double the effective worker concurrency/provider load.
PROSTUDIO_WORKER_ENABLED=1
PROSTUDIO_WORKER_CONCURRENCY=3
SUBSCRIPTION_REMINDER_WORKER_ENABLED=1
VOICE_AVATAR_AUTO_GENERATION=0
# How long a job can sit abandoned (crashed/redeployed worker, no live
# provider_slot lease left) before it's marked failed and its credits
# released. A job that's genuinely still running always has a live lease,
# so this never cuts off a real generation - it only bounds cleanup time.
PROSTUDIO_STALE_PROCESSING_MINUTES=5

# Global concurrent-generation cap per provider, shared across all Mini App
# users and worker replicas (provider_concurrency.py). Each falls back to a
# provider-specific default (not a flat 1 for everyone) chosen from that
# provider's lowest commonly documented trial/paid concurrency ceiling as of
# 2026 - safe on an unconfirmed account tier, but still much less serialized
# than before. Raise these once you've confirmed your actual tier with each
# provider; a value set higher than what the provider truly allows just
# causes that provider to throttle/queue the excess itself.
# KLING: trial tier allows 5 concurrent tasks; default stays under that.
PROVIDER_CONCURRENCY_KLING=3
# RUNWAY: Tier 1 (default) allows exactly 1 concurrent generation per org;
# raise only after confirming a higher paid tier (3-5+).
PROVIDER_CONCURRENCY_RUNWAY=1
# BYTEPLUS (Seedance/Seedream): no public concurrency limit documented;
# treated conservatively like other async video/image job providers.
PROVIDER_CONCURRENCY_BYTEPLUS=2
# QWEN (DashScope): no low documented ceiling found; moderate default.
PROVIDER_CONCURRENCY_QWEN=3
# OPENAI: generous documented per-minute request/image limits on paid tiers.
PROVIDER_CONCURRENCY_OPENAI=4
# GEMINI: generous documented limits on paid tiers, similar to OpenAI.
PROVIDER_CONCURRENCY_GEMINI=4
# ELEVENLABS: Free/Starter tiers allow 2-3 concurrent requests; Creator+ allow
# 5-15. Default matches the lowest paid tier.
PROVIDER_CONCURRENCY_ELEVENLABS=2
# HEYGEN/HEDRA/HIGGSFIELD/LUMA: async video job providers with no low public
# concurrency ceiling found; treated conservatively like Kling/BytePlus.
PROVIDER_CONCURRENCY_HEYGEN=2
PROVIDER_CONCURRENCY_HEDRA=2
PROVIDER_CONCURRENCY_HIGGSFIELD=2
PROVIDER_CONCURRENCY_LUMA=2
# FLUX (Black Forest Labs)/IDEOGRAM/RECRAFT: synchronous-ish image APIs with
# no low documented ceiling found; moderate default.
PROVIDER_CONCURRENCY_FLUX=3
PROVIDER_CONCURRENCY_IDEOGRAM=3
PROVIDER_CONCURRENCY_RECRAFT=3
# FASHN: niche virtual try-on provider, no public concurrency docs found;
# conservative default.
PROVIDER_CONCURRENCY_FASHN=2
# GROK (xAI): generous documented limits, similar to OpenAI.
PROVIDER_CONCURRENCY_GROK=4

# How long a provider concurrency slot stays reserved after a worker dies
# without releasing it (crash, redeploy mid-job) before another request for
# that provider can reclaim it. A live job renews its lease every
# PROVIDER_SLOT_HEARTBEAT_SECONDS, so keep the TTL at least 2-3x the
# heartbeat interval or a normal renewal delay could look like a dead worker.
PROVIDER_SLOT_TTL_SECONDS=90
PROVIDER_SLOT_HEARTBEAT_SECONDS=30

# Keep existing provider credentials, model maps and tariff settings.
OPENAI_API_KEY=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
