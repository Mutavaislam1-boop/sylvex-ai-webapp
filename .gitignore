# Admin Console: dist/ is committed (served at /admin); sources stay, deps never ship.
admin_console/node_modules/

# Store 3D card (store_lanyard/): the built bundle in webapp/js/vendor/store-lanyard is committed, deps never ship.
store_lanyard/node_modules/

# Pro Studio reference stack (studio_stack/): the built bundle in webapp/js/vendor/ref-stack is committed, deps never ship.
studio_stack/node_modules/

# Store cards glow (store_glow/): the built bundle in webapp/js/vendor/store-glow is committed, deps never ship.
store_glow/node_modules/
edit_pixel/node_modules/
grid_dock/node_modules/
swipe_toast/node_modules/
mode_segment/node_modules/
